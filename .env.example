# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Embeddings: choose "ollama" or "sentence_transformers"
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# If EMBEDDING_BACKEND=ollama, set:
# EMBEDDING_MODEL=qwen3-embedding:0.6b

# Retrieval
TOP_K=5

# Storage (local vector store: pure Python + numpy, no native
# extensions, no telemetry -- see src/store/vector_store.py)
VECTOR_STORE_DIR=./vector_store
DATA_DIR=./data/letters

# Generation
GENERATION_TEMPERATURE=0.2

# Export (DOCX/PDF) -- must be a font actually installed on this
# machine; the default was verified in this project's own build (see
# README). PDF export additionally needs the soffice binary on PATH.
DOCX_FONT_NAME=Noto Sans Devanagari
DOCX_FONT_SIZE_PT=12
DOCX_MARGIN_CM=2.5
DOCX_LINE_SPACING=1.5
EXPORT_TMP_DIR=./tmp_exports

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8000
